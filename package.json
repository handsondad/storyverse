{
  "name": "storyverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node tests/story-rules.mjs",
    "snapshot": "node tools/snapshot.mjs",
    "story:new": "node tools/new-story.mjs",
    "font": "node tools/font/subset.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "puppeteer-core": "^24.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
