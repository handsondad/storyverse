# 飞书多维表格配置
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_BITABLE_TOKEN=xxxxxxxxxx

# 魔搭 API 配置（用于图片生成）
MODEL_SCOPE_API_TOKEN=ms_xxxxxxxxxxxxxxxxxxxxx

# 启用飞书存储（设置为 true 启用，false 或不设置则使用本地存储）
USE_FEISHU_STORAGE=false

# JWT 密钥（请使用密码管理器生成至少 32 位随机值）
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# 首次启动创建管理员时使用（至少 12 位，不会返回给前端）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# 服务器端口
PORT=3000